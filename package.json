{
  "name": "@vinicunca/perkakas",
  "type": "module",
  "version": "1.13.2",
  "packageManager": "pnpm@10.33.0",
  "description": "Utility for JavaScript and Typescript.",
  "author": "praburangki<https://github.com/praburangki>",
  "license": "MIT",
  "homepage": "https://github.com/vinicunca/perkakas#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vinicunca/perkakas.git"
  },
  "bugs": {
    "url": "https://github.com/vinicunca/perkakas/issues"
  },
  "keywords": [
    "javascript utility",
    "typescript utility",
    "javascript utilities",
    "typescript utilities",
    "javascript helpers",
    "typescript helpers"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "files": [
    "dist/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "prepublish": "pnpm run build",
    "dev": "pnpm build --watch",
    "lint": "eslint . --fix",
    "publish:ci": "pnpm publish --access public --no-git-checks",
    "release": "bumpp package.json",
    "test": "vitest",
    "test:coverage": "vitest run --coverage --project runtime",
    "test:prop": "vitest --project prop",
    "test:runtime": "vitest --project runtime",
    "test:types": "vitest --project types"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.2",
    "@fast-check/vitest": "^0.4.0",
    "@types/node": "^25.5.2",
    "@vinicunca/eslint-config": "5.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "bumpp": "^10.3.2",
    "eslint": "^10.2.0",
    "fast-check": "^4.7.0",
    "publint": "^0.3.14",
    "tsdown": "^0.21.7",
    "type-fest": "^5.5.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
